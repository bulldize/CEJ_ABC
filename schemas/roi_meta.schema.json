{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "roi_meta",
  "type": "object",
  "required": [
    "case_id",
    "tooth_id",
    "roi_origin_in_full",
    "roi_shape",
    "full_shape",
    "spacing",
    "affine",
    "coord_type",
    "space"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "tooth_id": {"type": ["string", "integer"]},
    "roi_origin_in_full": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 3,
      "maxItems": 3
    },
    "roi_shape": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 3,
      "maxItems": 3
    },
    "full_shape": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 3,
      "maxItems": 3
    },
    "spacing": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "affine": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "number"},
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "coord_type": {"type": "string", "enum": ["voxel", "world"]},
    "space": {"type": "string", "enum": ["roi", "full"]},
    "bbox_full": {
      "type": "object",
      "properties": {
        "min": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3},
        "max": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3}
      }
    },
    "padding_mm": {"type": "number"},
    "target_spacing_mm": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "resampled": {"type": "boolean"}
  }
}
